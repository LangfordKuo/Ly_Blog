{% extends "layout.twig" %}{% block title %}分类: {{ category.name|escape }} - {{ site_name }}{% endblock %}{% block content %}<div class="container"><div class="content-area full-width"><h1 class="page-title">分类: {{ category.name|escape }}</h1>{% if items|length == 0 %}<div class="empty"><p>该分类下暂无文章</p></div>{% else %}{% for a in items %}<article class="article-card">{% if t_show_cover == '1' and a.cover_image %}<div class="card-cover"><img data-src="{{ a.cover_image|escape }}" src="{{ a.cover_image|escape }}" alt=""></div>{% endif %}<div class="card-body"><h2><a href="{{ site_url }}/article/{{ a.slug|escape }}">{{ a.title|escape }}</a></h2><div class="card-meta"><span>{{ a.published_at|date('Y-m-d') }}</span></div>{% if a.excerpt %}<p class="card-excerpt">{{ a.excerpt|escape }}</p>{% endif %}</div></article>{% endfor %}{% endif %}</div></div>{% endblock %}