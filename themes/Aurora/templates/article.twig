{% extends "layout.twig" %}{% block title %}{{ article.title|escape }} - {{ site_name }}{% endblock %}{% block meta %}<meta name="description" content="{{ article.excerpt|escape }}"><meta property="og:title" content="{{ article.title|escape }}"><meta property="og:description" content="{{ article.excerpt|escape }}"><meta property="og:url" content="{{ site_url }}/article/{{ article.slug|escape }}"><meta property="og:type" content="article"><meta property="og:site_name" content="{{ site_name }}">{% if article.cover_image %}<meta property="og:image" content="{{ article.cover_image|escape }}">{% endif %}<meta name="twitter:card" content="summary_large_image"><meta property="article:published_time" content="{{ article.published_at }}">{% endblock %}{% block content %}{% if json_ld %}{{ json_ld|raw }}{% endif %}
<article class="article-container">
    <header class="article-header">
        {% if category %}<a href="{{ site_url }}/category/{{ category.slug|escape }}" class="category-badge">{{ category.name|escape }}</a>{% endif %}
        <h1>{{ article.title|escape }}</h1>
        <div class="article-meta">
            <span>📅 {{ article.published_at|date('Y-m-d') }}</span><span class="dot"></span>
            <span>👁 {{ article.views }} 阅读</span><span class="dot"></span>
            <span>❤ {{ article.likes }} 赞</span>
            {% if article.read_time %}<span class="dot"></span><span class="read-time">⏱ {{ article.read_time }} 分钟</span>{% endif %}
        </div>
    </header>

    {% if t_show_cover == '1' and article.cover_image %}<div class="article-cover"><img src="{{ article.cover_image|escape }}" alt=""></div>{% endif %}

    <div class="content-area {{ t_layout|default('dual-sidebar') }}">
        {% if t_toc_enabled == '1' and t_layout == 'dual-sidebar' %}<aside class="toc-sidebar"><h4>目录</h4><ul class="toc-list" id="toc-list"></ul></aside>{% endif %}
        <div class="article-content">{{ article.content|raw }}</div>
    </div>

    {% if t_show_share == '1' %}<div class="share-buttons"><span style="font-size:14px;color:var(--text3);font-weight:500">分享:</span><button class="share-btn" data-platform="twitter">Twitter</button><button class="share-btn" data-platform="weibo">微博</button><button class="share-btn" data-platform="facebook">Facebook</button></div>{% endif %}

    {% if tags|length > 0 %}<div style="display:flex;gap:8px;flex-wrap:wrap;padding:20px 0">{% for tag in tags %}<a href="{{ site_url }}/tag/{{ tag.slug|escape }}" class="tag">{{ tag.name|escape }}</a>{% endfor %}</div>{% endif %}

    <div class="article-actions"><button class="like-btn{% if liked %} liked{% endif %}" data-id="{{ article.id }}" data-csrf="{{ csrf_token }}">❤ <span class="count">{{ article.likes }}</span></button></div>

    {% if author %}<div class="author-box">{% if author.avatar_url %}<img src="{{ author.avatar_url|escape }}" width="64" height="64" style="border-radius:50%" alt="">{% else %}<div class="author-avatar">{{ author.display_name|slice('0,1')|upper }}</div>{% endif %}<div class="author-info"><h4>{{ author.display_name|escape }}</h4><p>{{ author.bio|escape }}</p></div></div>{% endif %}

    {% if t_show_related == '1' and related|length > 0 %}<div class="related"><h2>相关推荐</h2><div class="related-grid">{% for r in related %}<div class="article-card"><div class="card-body"><span class="card-category">{{ r.category_name|escape }}</span><h2 style="font-size:18px"><a href="{{ site_url }}/article/{{ r.slug|escape }}">{{ r.title|escape }}</a></h2><div class="card-meta"><span>📅 {{ r.published_at|date('Y-m-d') }}</span><span class="dot"></span><span>👁 {{ r.views }}</span></div></div></div>{% endfor %}</div></div>{% endif %}

    <div class="comments-section"><h2>评论 ({{ comment_count }})</h2>{% if comments|length > 0 %}<div class="comment-list">{{ comments_html|raw }}</div>{% else %}<p class="no-comments" style="text-align:center;color:var(--text2);padding:40px 0">暂无评论，写下你的想法吧</p>{% endif %}<div class="comment-form"><h3 style="font-size:18px;font-weight:600;margin-bottom:16px">发表评论</h3><form method="post" action="{{ site_url }}/comment/{{ article.id }}">{{ csrf_field|raw }}<div class="form-row"><div class="form-group"><input type="text" name="author_name" placeholder="昵称 *" required></div><div class="form-group"><input type="email" name="author_email" placeholder="邮箱"></div></div><div class="form-row"><div class="form-group"><input type="url" name="author_url" placeholder="网址"></div></div><div class="form-group"><textarea name="content" placeholder="写下你的评论..." required rows="4"></textarea></div><button type="submit" class="btn btn-primary">提交评论</button></form></div></div>

    {% if prev or next %}<div class="article-nav" style="display:flex;justify-content:space-between;gap:16px;margin-top:40px;padding:24px 0;border-top:1px solid var(--border)">{% if prev %}<a href="{{ site_url }}/article/{{ prev.slug|escape }}" style="flex:1;text-align:left"><span style="font-size:12px;color:var(--text3);display:block">← 上一篇</span><span style="font-weight:600">{{ prev.title|escape }}</span></a>{% else %}<span style="flex:1"></span>{% endif %}{% if next %}<a href="{{ site_url }}/article/{{ next.slug|escape }}" style="flex:1;text-align:right"><span style="font-size:12px;color:var(--text3);display:block">下一篇 →</span><span style="font-weight:600">{{ next.title|escape }}</span></a>{% endif %}</div>{% endif %}
</article>{% endblock %}