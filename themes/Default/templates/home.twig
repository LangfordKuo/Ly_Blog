{% extends "layout.twig" %}{% block title %}{{ site_name }}{% endblock %}{% block content %}{% if items|length == 0 %}<div class="empty"><div class="empty-icon">📝</div><h2 style="font-size:20px;font-weight:300;margin-bottom:8px">{{ site_name }}</h2><p>博客已就绪，开始发布第一篇文章吧。</p></div>{% else %}{% for article in items %}<article class="card card-{{ t_card_style }}">{% if t_show_cover == '1' and article.cover_image %}<div class="card-cover"><img src="{{ article.cover_image|escape }}" alt=""></div>{% endif %}<div class="card-body"><h2><a href="{{ site_url }}/article/{{ article.slug|escape }}">{% if article.is_pinned %}📌 {% endif %}{{ article.title|escape }}</a></h2><div class="card-meta"><span>{{ article.published_at|date('Y-m-d') }}</span><span>{{ article.views }} 阅读</span><span>{{ article.likes }} ♥</span></div>{% if article.excerpt %}<p class="card-excerpt">{{ article.excerpt|escape }}</p>{% endif %}<a href="{{ site_url }}/article/{{ article.slug|escape }}" class="read-more">阅读全文 →</a></div></article>{% endfor %}{% if has_more %}<div class="pagination"><a href="?page={{ next_page }}">更多文章 →</a></div>{% endif %}{% endif %}<aside class="sidebar">{% if categories|length > 0 %}<div class="card"><h3>分类</h3><ul>{% for cat in categories %}<li><a href="{{ site_url }}/category/{{ cat.slug|escape }}">{{ cat.name|escape }}</a></li>{% endfor %}</ul></div>{% endif %}{% if tags|length > 0 %}<div class="card"><h3>标签</h3><div class="tag-cloud">{% for tag in tags %}<a href="{{ site_url }}/tag/{{ tag.slug|escape }}" class="tag">{{ tag.name|escape }} ({{ tag.article_count }})</a>{% endfor %}</div></div>{% endif %}</aside>{% if popular|length > 0 %}<div class="card"><h3>🔥 热门文章</h3>{% for p in popular %}<a href="{{ site_url }}/article/{{ p.slug|escape }}" style="display:block;padding:6px 0;color:var(--text-2);font-size:14px;border-bottom:1px solid var(--border)">{{ p.title|escape }} <span style="float:right;font-size:12px">{{ p.views }}</span></a>{% endfor %}</div>{% endif %}{% endblock %}