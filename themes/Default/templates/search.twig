{% extends "layout.twig" %}{% block title %}搜索 - {{ site_name }}{% endblock %}{% block content %}<form method="get" action="{{ site_url }}/search" class="search-form"><input type="text" name="q" value="{{ query|escape }}" placeholder="搜索文章..." autofocus><button type="submit" class="btn btn-primary">搜索</button></form>{% if items|length == 0 and query|length == 0 %}<div class="empty"><div class="empty-icon">🔍</div><p>请输入搜索关键词</p></div>{% elseif items|length == 0 %}<h1 class="page-title">搜索: "{{ query|escape }}" (共 0 条)</h1><div class="empty"><p>未找到相关文章</p></div>{% else %}<h1 class="page-title">搜索: "{{ query|escape }}" (共 {{ total }} 条)</h1>{% for a in items %}<article class="card"><h2><a href="{{ site_url }}/article/{{ a.slug|escape }}">{{ a.title_hl|raw }}</a></h2><div class="card-meta">{{ a.published_at|date('Y-m-d') }}</div>{% if a.excerpt_hl %}<p class="card-excerpt">{{ a.excerpt_hl|raw }}</p>{% endif %}<a href="{{ site_url }}/article/{{ a.slug|escape }}" class="read-more">阅读全文 →</a></article>{% endfor %}{% if has_more %}<div class="pagination"><a href="?q={{ query|escape }}&page={{ next_page }}">更多 →</a></div>{% endif %}{% endif %}{% endblock %}