{% extends "layout.twig" %}{% block title %}归档 - {{ site_name }}{% endblock %}{% block content %}{% if year %}<p style="margin-bottom:20px"><a href="{{ site_url }}/archive">← 返回</a></p><h1 class="page-title">{{ year }} 年{% if month %}{{ month }} 月{% endif %} 归档</h1>{% if items|length == 0 %}<div class="empty"><p>该月份没有文章</p></div>{% else %}{% for a in items %}<article class="card"><h2><a href="{{ site_url }}/article/{{ a.slug|escape }}">{{ a.title|escape }}</a></h2><div class="card-meta">{{ a.published_at|date('Y-m-d') }}</div>{% if a.excerpt %}<p class="card-excerpt">{{ a.excerpt|escape }}</p>{% endif %}</article>{% endfor %}{% if has_more %}<div class="pagination"><a href="?page={{ next_page }}">更多 →</a></div>{% endif %}{% endif %}{% else %}<h1 class="page-title">文章归档</h1>{% if archives|length == 0 %}<div class="empty"><div class="empty-icon">📅</div><p>暂无文章</p></div>{% else %}{% for y in archives %}<div class="card"><h2 style="font-size:20px;margin-bottom:12px">{{ y.year }} 年</h2><ul class="archive-list">{% for m in y.months %}<li><a href="{{ site_url }}/archive/{{ y.year }}/{{ m.month }}">{{ y.year }}年{{ m.month }}月</a><span class="count">{{ m.count }} 篇</span></li>{% endfor %}</ul></div>{% endfor %}{% endif %}{% endif %}{% endblock %}