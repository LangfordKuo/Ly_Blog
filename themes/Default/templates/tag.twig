{% extends "layout.twig" %}{% block title %}标签: {{ tag.name|escape }} - {{ site_name }}{% endblock %}{% block content %}<h1 class="page-title">标签: {{ tag.name|escape }}</h1>{% if items|length == 0 %}<div class="empty"><p>该标签下暂无文章</p></div>{% else %}{% for a in items %}<article class="card"><h2><a href="{{ site_url }}/article/{{ a.slug|escape }}">{{ a.title|escape }}</a></h2><div class="card-meta">{{ a.published_at|date('Y-m-d') }}</div>{% if a.excerpt %}<p class="card-excerpt">{{ a.excerpt|escape }}</p>{% endif %}</article>{% endfor %}{% if has_more %}<div class="pagination"><a href="?page={{ next_page }}">更多 →</a></div>{% endif %}{% endif %}{% endblock %}