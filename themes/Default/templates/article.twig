{% extends "layout.twig" %}{% block title %}{{ article.title|escape }} - {{ site_name }}{% endblock %}{% block meta %}<meta name="description" content="{{ article.excerpt|default(site_description)|escape }}">{% if article.cover_image %}<meta property="og:image" content="{{ article.cover_image|escape }}">{% endif %}{% endblock %}{% block content %}<article class="article-full"><header class="article-header">{% if t_show_cover == '1' and article.cover_image %}<img src="{{ article.cover_image|escape }}" alt="" class="article-cover">{% endif %}<h1>{{ article.title|escape }}</h1><div class="article-meta"><span>📅 {{ article.published_at|date('Y-m-d') }}</span>{% if category %}<span>📁 <a href="{{ site_url }}/category/{{ category.slug|escape }}">{{ category.name|escape }}</a></span>{% endif %}<span>👁 {{ article.views }} 阅读</span><span>❤ {{ article.likes }} 赞</span></div></header><div class="article-content">{{ article.content|raw }}</div>{% if tags|length > 0 %}<div class="article-tags">{% for tag in tags %}<a href="{{ site_url }}/tag/{{ tag.slug|escape }}" class="tag">{{ tag.name|escape }}</a>{% endfor %}</div>{% endif %}<div class="article-actions"><button class="like-btn {% if liked %}liked{% endif %}" data-id="{{ article.id }}" onclick="toggleLike(this)">❤ <span class="count">{{ article.likes }}</span></button></div></article><section class="comments"><h2>评论 ({{ comment_count }})</h2>{% if comments|length > 0 %}<div class="comment-list">{{ comments_html|raw }}</div>{% else %}<p class="no-comments">暂无评论，来抢沙发吧~</p>{% endif %}<div class="comment-form"><h3>发表评论</h3><form method="post" action="{{ site_url }}/comment/{{ article.id }}">{{ csrf_field|raw }}<div class="form-row"><input type="text" name="author_name" placeholder="昵称 *" required></div><div class="form-row"><input type="email" name="author_email" placeholder="邮箱"></div><div class="form-row"><input type="url" name="author_url" placeholder="网址"></div><div class="form-row"><textarea name="content" placeholder="写下你的评论..." required rows="4"></textarea></div><button type="submit" class="btn btn-primary">提交评论</button></form></div></section>{% endblock %}{% block scripts %}<script>function toggleLike(b){var i=b.dataset.id;fetch("{{ site_url }}/like/"+i,{method:"POST",headers:{"X-Requested-With":"XMLHttpRequest","X-CSRF-Token":"{{ csrf_token }}"}}).then(function(r){return r.json()}).then(function(d){b.querySelector(".count").textContent=d.count;b.classList.toggle("liked",d.liked)})}</script>{% endblock %}