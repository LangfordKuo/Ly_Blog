{% extends "layout.twig" %}{% block title %}{{ article.title|escape }} - {{ site_name }}{% endblock %}{% block meta %}<meta name="description" content="{{ article.excerpt|escape }}"><meta property="og:title" content="{{ article.title|escape }}"><meta property="og:description" content="{{ article.excerpt|escape }}"><meta property="og:url" content="{{ site_url }}/article/{{ article.slug|escape }}"><meta property="og:type" content="article"><meta property="og:site_name" content="{{ site_name }}">{% if article.cover_image %}<meta property="og:image" content="{{ article.cover_image|escape }}">{% endif %}<meta name="twitter:card" content="summary_large_image"><meta property="article:published_time" content="{{ article.published_at }}">{% endblock %}{% block content %}{% if json_ld %}{{ json_ld|raw }}{% endif %}<article class="article-full"><header class="article-header">{% if t_show_cover == '1' and article.cover_image %}<img src="{{ article.cover_image|escape }}" alt="" class="article-cover">{% endif %}<h1>{{ article.title|escape }}</h1><div class="article-meta"><span>📅 {{ article.published_at|date('Y-m-d') }}</span>{% if category %}<span>📁 <a href="{{ site_url }}/category/{{ category.slug|escape }}">{{ category.name|escape }}</a></span>{% endif %}<span>👁 {{ article.views }} 阅读</span><span>❤ {{ article.likes }} 赞</span></div></header><div class="article-content">{{ article.content|raw }}</div>{% if tags|length > 0 %}<div class="article-tags">{% for tag in tags %}<a href="{{ site_url }}/tag/{{ tag.slug|escape }}" class="tag">{{ tag.name|escape }}</a>{% endfor %}</div>{% endif %}<div class="article-actions"><button class="like-btn {% if liked %}liked{% endif %}" data-id="{{ article.id }}" onclick="toggleLike(this)">❤ <span class="count">{{ article.likes }}</span></button><button onclick="copyLink()" style="margin-left:8px;padding:8px 14px;border:1px solid var(--border);border-radius:8px;background:transparent;font-size:13px;cursor:pointer;font-family:inherit;color:var(--text-2)">📋 复制链接</button></div></article><section class="comments"><h2>评论 ({{ comment_count }})</h2>{% if comments|length > 0 %}<div class="comment-list">{{ comments_html|raw }}</div>{% else %}<p class="no-comments">暂无评论，来抢沙发吧~</p>{% endif %}<div class="comment-form"><h3>发表评论</h3><form method="post" action="{{ site_url }}/comment/{{ article.id }}">{{ csrf_field|raw }}<div class="form-row"><input type="text" name="author_name" placeholder="昵称 *" required></div><div class="form-row"><input type="email" name="author_email" placeholder="邮箱"></div><div class="form-row"><input type="url" name="author_url" placeholder="网址"></div><div class="form-row"><textarea name="content" placeholder="写下你的评论..." required rows="4"></textarea></div><button type="submit" class="btn btn-primary">提交评论</button></form></div></section>{% if prev or next %}<div class="article-nav" style="display:flex;justify-content:space-between;gap:16px;margin:40px 0 0;padding:20px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)">{% if prev %}<a href="{{ site_url }}/article/{{ prev.slug|escape }}" style="max-width:48%"><span style="font-size:12px;color:var(--text-2)">← 上一篇</span><br><span>{{ prev.title|escape }}</span></a>{% else %}<span></span>{% endif %}{% if next %}<a href="{{ site_url }}/article/{{ next.slug|escape }}" style="max-width:48%;text-align:right"><span style="font-size:12px;color:var(--text-2)">下一篇 →</span><br><span>{{ next.title|escape }}</span></a>{% endif %}</div>{% endif %}{% endblock %}{% block scripts %}<script>function toggleLike(b){var i=b.dataset.id;fetch("{{ site_url }}/like/"+i,{method:"POST",headers:{"X-Requested-With":"XMLHttpRequest","X-CSRF-Token":"{{ csrf_token }}"}}).then(function(r){return r.json()}).then(function(d){b.querySelector(".count").textContent=d.count;b.classList.toggle("liked",d.liked)})}function replyTo(id,name){var f=document.querySelector(".comment-form form");var p=document.querySelector("input[name=parent_id]");if(!p){p=document.createElement("input");p.type="hidden";p.name="parent_id";f.appendChild(p)}p.value=id;var t=f.querySelector("textarea");if(t){t.placeholder="@name回复...";t.focus()}f.querySelector("h3").textContent="回复: "+name;window.scrollTo({top:f.offsetTop-60,behavior:"smooth"})}function copyLink(){var u=window.location.href;if(navigator.clipboard){navigator.clipboard.writeText(u);var btn=document.querySelectorAll("[onclick^=copyLink]")[0];if(btn){btn.textContent="已复制!";setTimeout(function(){btn.textContent="📋 复制链接"},2000)}}else{prompt("复制:",u)}}</script>{% endblock %}